mod std::maps {
    value MapKey(str);

    enum MapEntry<T> {
        Entry(MapKey, T),
    }

    opaque struct OrderedMap<T> {
        entries: [MapEntry<T>];
    }

    enum Indexed<T> {
        Entries([MapKey], [MapEntry<T>]),
    }

    enum KeyScan {
        Empty,
        Previous(MapKey),
        Duplicate(MapKey),
    }

    pub fn map_empty<T>() -> OrderedMap<T> {
        OrderedMap<T> { entries = []; }
    }

    // Ordering is lexicographic UTF-8 bytes. Insertion never overwrites a key.
    pub fn map_insert<T>(
        items: OrderedMap<T>,
        key: MapKey,
        item: T,
    ) -> Result<OrderedMap<T>, MapKey> {
        map_from_entries(items.entries ++ [MapEntry::Entry(key, item)])
    }

    pub fn map_from_entries<T>(entries: [MapEntry<T>]) -> Result<OrderedMap<T>, MapKey> {
        let indexed = fold(
            entries,
            Indexed::Entries<T>([], []),
            fn(state: Indexed<T>, entry: MapEntry<T>) -> Indexed<T> {
                match state {
                    Entries(keys, items) => match entry {
                        Entry(key, item) => Indexed::Entries(
                            keys ++ [key], items ++ [MapEntry::Entry(key, item)],
                        ),
                    },
                }
            },
        );
        match indexed {
            Entries(keys, items) => finish_map(keys, items),
        }
    }

    fn finish_map<T>(keys: [MapKey], items: [MapEntry<T>]) -> Result<OrderedMap<T>, MapKey> {
        let scanned = fold(
            sort_by_keys(keys, keys),
            KeyScan::Empty,
            fn(state: KeyScan, key: MapKey) -> KeyScan {
                match state {
                    Empty => KeyScan::Previous(key),
                    Previous(previous) => compare(
                        previous, key,
                        KeyScan::Previous(key), KeyScan::Duplicate(key), KeyScan::Previous(key),
                    ),
                    Duplicate(key) => KeyScan::Duplicate(key),
                }
            }
        );
        match scanned {
            Empty => Result::Ok(OrderedMap<T> { entries = sort_by_keys(items, keys); }),
            Previous(_) => Result::Ok(OrderedMap<T> { entries = sort_by_keys(items, keys); }),
            Duplicate(key) => Result::Err(key),
        }
    }

    // Lookup consumes an affine map; reusable maps remain reusable values.
    pub fn map_get<T>(items: OrderedMap<T>, key: MapKey) -> Option<T> {
        fold(
            items.entries,
            Option::None<T>(),
            fn(found: Option<T>, entry: MapEntry<T>) -> Option<T> {
                match found {
                    Some(item) => Option::Some(item),
                    None => match entry {
                        Entry(existing, item) => compare(
                            key,
                            existing,
                            Option::None(),
                            Option::Some(item),
                            Option::None(),
                        ),
                    },
                }
            },
        )
    }

    pub fn map_entries<T>(items: OrderedMap<T>) -> [MapEntry<T>] {
        items.entries
    }

    pub fn map_merge<T>(
        left: OrderedMap<T>,
        right: OrderedMap<T>,
    ) -> Result<OrderedMap<T>, MapKey> {
        map_from_entries(left.entries ++ right.entries)
    }

    pub fn map_keys<T>(items: OrderedMap<T>) -> [MapKey] {
        map(items.entries, fn(entry: MapEntry<T>) -> MapKey {
            match entry { Entry(key, _) => key }
        })
    }

    pub fn map_values<T>(items: OrderedMap<T>) -> [T] {
        map(items.entries, fn(entry: MapEntry<T>) -> T {
            match entry { Entry(_, item) => item }
        })
    }
}
