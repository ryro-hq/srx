mod std::pkg {
    value PackageId(str);
    value SourceUrl(str);
    value SourceDigest(str);
    value SourceLimit(int);
    struct Dependency {
        recipe: RecipeRef<Recipe>;
    }
    struct Package {
        id: PackageId;
        dependencies: [Dependency];
    }
    struct SourceRequest {
        url: SourceUrl;
        sha256: SourceDigest;
        maximum_bytes: SourceLimit;
    }
    pub fn source_request(url: SourceUrl, digest: SourceDigest, limit: SourceLimit,) -> SourceRequest {
        SourceRequest {
            url = url;
            sha256 = digest;
            maximum_bytes = limit;
        }
    }
    struct Acquisition {
        sources: [SourceRequest];
    }
}
